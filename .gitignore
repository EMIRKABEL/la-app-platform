# ============================================================
# LA App Platform — Root .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/
.venv/
venv/
env/
ENV/

# ---- Node.js ----
node_modules/
.next/
out/
.nuxt/
.cache/
*.tsbuildinfo
.npm
.pnp.*
yarn-error.log
pnpm-debug.log*
npm-debug.log*

# ---- Environment files ----
.env
.env.*
!.env.example
!.env.template

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Testing / Coverage ----
coverage/
.coverage
htmlcov/
.tox/
.pytest_cache/

# ---- Docker ----
# Keep docker-compose.yml tracked, ignore local overrides
docker-compose.override.yml

# ---- Misc ----
*.log
*.local
tmp/
temp/

# ---- Local file storage (curriculum uploads, generated content) ----
/storage/*
!/storage/README.md
backend/storage/

